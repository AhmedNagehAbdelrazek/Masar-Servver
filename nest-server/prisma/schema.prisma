model SubscriptionPlan {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(100)
  periodDays    Int      @map("period_days")
  percentageCut Decimal  @default(0) @map("percentage_cut") @db.Decimal(5, 2)
  cost          Decimal  @default(0) @db.Decimal(10, 2)
  status        String?  @db.VarChar(30)
  features      Json     @default("[]") @db.JsonB
  isFree        Boolean  @default(false) @map("is_free")
  freeOffer     Json?    @map("free_offer") @db.JsonB
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("createdat") @db.Timestamptz
  updatedAt     DateTime @default(now()) @updatedAt @map("updatedat") @db.Timestamptz

