model DriverSubscription {
  id                String             @id @default(uuid()) @db.Uuid
  driverId          String             @map("driver_id") @db.Uuid
  planId            String             @map("plan_id") @db.Uuid
  planName          String             @map("plan_name") @db.VarChar(100)
  planPeriodDays    Int                @map("plan_period_days")
  planPercentageCut Decimal            @map("plan_percentage_cut") @db.Decimal(5, 2)
  planCost          Decimal            @map("plan_cost") @db.Decimal(10, 2)
  balance           Decimal            @default(0) @db.Decimal(10, 2)
  screenshotId      Int?               @map("screenshot_id")
  paymentMethod     Json               @map("payment_method") @db.JsonB
  adminNotes        String?            @map("admin_notes") @db.Text
  status            SubscriptionStatus @default(pending_approval)
  approvedAt        DateTime?          @map("approved_at") @db.Timestamptz
  activatedAt       DateTime?          @map("activated_at") @db.Timestamptz
  expiresAt         DateTime?          @map("expires_at") @db.Timestamptz
  freeTripsUsed     Int                @default(0) @map("free_trips_used")
  freeOffer         Json?              @map("free_offer") @db.JsonB
  createdAt         DateTime           @default(now()) @map("createdat") @db.Timestamptz
  updatedAt         DateTime           @default(now()) @updatedAt @map("updatedat") @db.Timestamptz

  driver     User             @relation(fields: [driverId], references: [id])
  plan       SubscriptionPlan @relation(fields: [planId], references: [id])
  screenshot UploadedImage?   @relation(fields: [screenshotId], references: [id])

  @@index([driverId, status], map: "idx_subscriptions_driver")
  @@index([planId], map: "idx_subscriptions_plan")
  @@index([status, expiresAt], map: "idx_subscriptions_expiry")
  @@map("driver_subscriptions")
}

