# Nest server (parallel to Main Server/ Express). Express stays on PORT=3000.
PORT=3001
NODE_ENV=development
APP_LOCALE=ar

DATABASE_URL=postgres://user:password@localhost:5432/app_db

JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRY=24h

# NOTE: Express default is 6380 (not 6379) — keep in sync.
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=

GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_REGION_CODE=jo
MAPS_MOCK=true
ROUTE_CACHE_TTL_SECONDS=86400

TRACKING_INTERVAL_SECONDS=5
TRACKING_BATCH_MAX_POINTS=60
TRACKING_MAX_POINT_AGE_SECONDS=300

# Audit collector (optional locally — interceptor is best-effort/no-op when unset)
AUDIT_COLLECTOR_URL=
AUDIT_CLIENT_KEY=
AUDIT_CLIENT_SECRET=

# SMS notifications
# SMS_PROVIDER: websmpp | twilio | log (log = console fallback for development)
# websmpp = Advance Messaging Systems / Broadnet gateway — the production
# provider documented in SMS_API.pdf / HLR_API.pdf (repo root).
SMS_PROVIDER=log
# websmpp gateway config (see SMS_API.pdf / HLR_API.pdf)
SMS_PROVIDER_BASE=https://gwjo1s.broadnet.me:8443
SMS_USERNAME=your-websmpp-system-id
SMS_PASSWORD=your-websmpp-password
SMS_SENDER_ID=Masar Car
# Optional: force message type (1=English 160ch, 2=Unicode 280ch, 3=Special 160ch, 4=Arabic 70ch)
# SMS_MESSAGE_TYPE=4
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM=your-twilio-from-number
