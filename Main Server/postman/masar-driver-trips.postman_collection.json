{
  "info": {
    "name": "Masar - Driver Trip Dashboard",
    "description": "API collection for Driver Trip Creation, Dashboard, and Seat Locking features.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "trip_id",
      "value": ""
    },
    {
      "key": "seat_number",
      "value": "2"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+962791234567\",\n  \"password\": \"Test@1234\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('access_token', jsonData.access_token);",
                  "    console.log('Token saved');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Trip",
      "item": [
        {
          "name": "Create Trip (Driver)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle_id\": \"{{vehicle_id}}\",\n  \"origin_city\": \"Amman\",\n  \"origin_area\": \"Abdoun\",\n  \"origin_lat\": \"31.9500\",\n  \"origin_lng\": \"35.9100\",\n  \"destination_city\": \"Irbid\",\n  \"destination_area\": \"Downtown\",\n  \"destination_lat\": \"32.5500\",\n  \"destination_lng\": \"35.8500\",\n  \"departure_date\": \"2026-08-15\",\n  \"departure_time\": \"14:00\",\n  \"type_of_trip\": \"once\",\n  \"fare_per_seat\": \"15.50\",\n  \"seats\": [\n    { \"seat_number\": 1, \"type\": \"driver\" },\n    { \"seat_number\": 2, \"type\": \"available\" },\n    { \"seat_number\": 3, \"type\": \"available\" },\n    { \"seat_number\": 4, \"type\": \"unavailable\" }\n  ],\n  \"instructions\": \"No smoking please\",\n  \"additional_instructions\": \"Bring water\",\n  \"waypoints\": [\n    { \"stop_name\": \"Khalda\", \"stop_lat\": \"31.9600\", \"stop_lng\": \"35.9000\" }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/trips",
              "host": ["{{base_url}}"],
              "path": ["trips"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.trip_id) {",
                  "    pm.collectionVariables.set('trip_id', jsonData.trip_id);",
                  "    console.log('Trip ID saved: ' + jsonData.trip_id);",
                  "}"
                ]
              }
            }
          ],
          "description": "Create a new trip. Requires driver role."
        },
        {
          "name": "Create Recurring Trip",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle_id\": \"{{vehicle_id}}\",\n  \"origin_city\": \"Amman\",\n  \"origin_area\": \"Abdoun\",\n  \"origin_lat\": \"31.9500\",\n  \"origin_lng\": \"35.9100\",\n  \"destination_city\": \"Irbid\",\n  \"destination_area\": \"Downtown\",\n  \"destination_lat\": \"32.5500\",\n  \"destination_lng\": \"35.8500\",\n  \"departure_date\": \"2026-08-15\",\n  \"departure_time\": \"14:00\",\n  \"type_of_trip\": \"repeated\",\n  \"repeated_days\": [1, 3, 5],\n  \"repeated_end_date\": \"2026-09-30\",\n  \"fare_per_seat\": \"15.50\",\n  \"seats\": [\n    { \"seat_number\": 1, \"type\": \"driver\" },\n    { \"seat_number\": 2, \"type\": \"available\" },\n    { \"seat_number\": 3, \"type\": \"available\" },\n    { \"seat_number\": 4, \"type\": \"unavailable\" }\n  ],\n  \"instructions\": \"No smoking please\",\n  \"waypoints\": [\n    { \"stop_name\": \"Khalda\", \"stop_lat\": \"31.9600\", \"stop_lng\": \"35.9000\" }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/trips",
              "host": ["{{base_url}}"],
              "path": ["trips"]
            }
          },
          "description": "Create a recurring trip (Mon/Wed/Fri)."
        },
        {
          "name": "Get Trip By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/trips/{{trip_id}}",
              "host": ["{{base_url}}"],
              "path": ["trips", "{{trip_id}}"]
            }
          },
          "description": "Get trip details including seats and stops."
        },
        {
          "name": "Get Driver Trips",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/trips/driver/my-trips",
              "host": ["{{base_url}}"],
              "path": ["trips", "driver", "my-trips"]
            }
          },
          "description": "Get all trips for the authenticated driver."
        },
        {
          "name": "Get Driver Trips (Filtered)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/trips/driver/my-trips?status=published",
              "host": ["{{base_url}}"],
              "path": ["trips", "driver", "my-trips"],
              "query": [
                {
                  "key": "status",
                  "value": "published",
                  "description": "Filter by trip status: published, in_progress, completed, cancelled"
                }
              ]
            }
          },
          "description": "Get driver trips filtered by status."
        },
        {
          "name": "Search Available Trips",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/trips/search/available?origin_city=Amman&destination_city=Irbid&date=2026-08-15",
              "host": ["{{base_url}}"],
              "path": ["trips", "search", "available"],
              "query": [
                {
                  "key": "origin_city",
                  "value": "Amman",
                  "description": "Origin city (optional)"
                },
                {
                  "key": "destination_city",
                  "value": "Irbid",
                  "description": "Destination city (optional)"
                },
                {
                  "key": "date",
                  "value": "2026-08-15",
                  "description": "Date in YYYY-MM-DD format"
                },
                {
                  "key": "gender_preference",
                  "value": "",
                  "description": "Gender filter: all, women_only, men_only (optional)"
                }
              ]
            }
          },
          "description": "Search available trips for passengers."
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Driver Dashboard",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/driver/dashboard",
              "host": ["{{base_url}}"],
              "path": ["driver", "dashboard"]
            }
          },
          "description": "Get aggregated driver dashboard: today's trips, upcoming, earnings, rating, reservation history."
        }
      ]
    },
    {
      "name": "Seat Lock",
      "item": [
        {
          "name": "Lock Seat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seat_number\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/trips/{{trip_id}}/seats/lock",
              "host": ["{{base_url}}"],
              "path": ["trips", "{{trip_id}}", "seats", "lock"]
            }
          },
          "description": "Lock a seat for 5 minutes while booking. Only available seats can be locked."
        },
        {
          "name": "Release Seat Lock",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/trips/{{trip_id}}/seats/lock/2",
              "host": ["{{base_url}}"],
              "path": ["trips", "{{trip_id}}", "seats", "lock", "2"]
            }
          },
          "description": "Release a previously locked seat."
        }
      ]
    }
  ]
}
