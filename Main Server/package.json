{
  "name": "@workspace/api-server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "start:js": "node server.js",
    "dev": "tsx watch server.ts",
    "dev:js": "nodemon server.js",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest tests/integration",
    "test:contract": "jest tests/contract",
    "test:unit": "jest tests/unit",
    "seed": "tsx seed.ts",
    "seed:js": "node seed.js",
    "seed:mock": "tsx seed-mock.ts",
    "seed:mock:js": "node seed-mock.js",
    "db:init": "tsx -e \"require('./migrations').initMigrations()\"",
    "db:migrate": "tsx -e \"require('./migrations').runMigrations()\"",
    "db:migrate:redo": "tsx -e \"require('./migrations').runMigrations({redo:true})\"",
    "db:migrate:generate": "node migrations/scripts/generate.js",
    "db:migrate:preview": "node migrations/scripts/generate.js --preview",
    "postinstall": "node scripts/patch-auto-migrations.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.0.0",
    "express-validator": "^7.0.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "node-cron": "^4.6.0",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sequelize-auto-migrations": "^1.0.3",
    "sequelize-cli": "^6.6.5",
    "socket.io": "^4.7.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.4",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
