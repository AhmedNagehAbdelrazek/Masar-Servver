    {
      "name": "Registration",
      "item": [
        {
          "name": "Step 1 - Register Phone",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OTP sent successfully', function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.environment.set('registered_phone', pm.response.json().phone || '962791234567');",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"country_code\": \"JO\",\n  \"phone\": \"791234565\",\n  \"role\": \"driver\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register/phone",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register",
                "phone"
              ]
            },
            "description": "Start registration by sending phone number. OTP will be logged to console."
          },
          "response": []
        },
        {
          "name": "Step 2 - Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OTP verified', function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.environment.set('registration_token', pm.response.json().registration_token);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+962791234565\",\n  \"otp\": \"906643\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register/verify-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register",
                "verify-otp"
              ]
            },
            "description": "Verify the OTP received via console. Replace OTP with the actual code."
          },
          "response": []
        },
        {
          "name": "Step 3 - Set Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Password set, tokens received', function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.environment.set('access_token', pm.response.json().access_token);",
                  "    pm.environment.set('refresh_token', pm.response.json().refresh_token);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{registration_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{registration_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"Test@1234\",\n  \"confirmPassword\": \"Test@1234\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register/password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register",
                "password"
              ]
            },
            "description": "Set password using the registration token from Step 2."
          },
          "response": []
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+962791234567\",\n  \"purpose\": \"register\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/resend-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "resend-otp"
              ]
            },
            "description": "Resend OTP if the previous one expired or wasn't received."
          },
          "response": []
        }
      ],
      "description": "Two-step registration flow for passengers and drivers.\n\nStep 1: Send phone → receive OTP\nStep 2: Verify OTP → receive registration token\nStep 3: Set password → receive JWT tokens"
    },
